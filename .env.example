# Copy to .env (gitignored). Never commit a real key.
# Optional: with a key here, the chat starts straight away. Without one, the page
# asks each user for their own key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional cheaper model for the extraction step; defaults to OPENAI_MODEL.
OPENAI_EXTRACT_MODEL=
# Optional: none | minimal | low | medium | high. Blank sends nothing (needed for
# models without reasoning controls). "low" keeps replies quick.
OPENAI_REASONING_EFFORT=
# ISO date used as "today" for deadline statements; defaults to the real date.
DEMO_TODAY=
OUT_OF_SCOPE_THRESHOLD=3
MAX_VERIFY_ATTEMPTS=3
# Times a caller can push back on verification or consent before a human is offered.
MAX_PUSHBACK=3
# default | timeout  (keys of apps/insurance_claims/fixtures/consent_scenarios.json)
CONSENT_SCENARIO=default
SESSION_TTL_MINUTES=30
